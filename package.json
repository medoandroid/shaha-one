{
  "name": "shaha-one",
  "private": true,
  "version": "6.0.0",
  "description": "SHAHA ONE | شها ون — المنصة الرقمية المتكاملة لخدمات أهالي قرية شها",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --bundle --format=esm --packages=external --outfile=dist/server.js",
    "build:netlify": "vite build",
    "build:worker": "esbuild cloudflare/worker.ts --bundle --format=esm --outfile=.cloudflare/shoha-one-api.mjs",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "backup": "node scripts/backup-restore.mjs export",
    "backup:verify": "node scripts/backup-restore.mjs verify"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
